<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3" data-tags="">us1.1 - Criação de conta (Sucesso)</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>https://bike-bake-mas34.vercel.app/<datalist><option>https://bike-bake-mas34.vercel.app/</option></datalist></td><td></td></tr>
<tr><td>click</td><td>id=go-to-register<datalist><option>id=go-to-register</option><option>xpath=//span[@id='go-to-register']</option><option>xpath=//div[@id='form-login']/span</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Iniciar Sessão'])[1]/following::span[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Bake'])[1]/following::span[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Alergias / Intolerâncias'])[1]/preceding::span[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Glúten'])[1]/preceding::span[1]</option><option>xpath=//*/text()[normalize-space(.)='Não tens conta? Regista-te']/parent::*</option><option>xpath=//div[2]/span</option><option>css=#go-to-register</option></datalist></td><td></td></tr>
<tr><td>click</td><td>id=reg-name<datalist><option>id=reg-name</option><option>xpath=//input[@id='reg-name']</option><option>xpath=//div[@id='form-register']/div/input</option><option>xpath=//div[3]/div/input</option><option>css=#reg-name</option></datalist></td><td></td></tr>
<tr><td>type</td><td>id=reg-name<datalist><option>id=reg-name</option><option>xpath=//input[@id='reg-name']</option><option>xpath=//div[@id='form-register']/div/input</option><option>xpath=//div[3]/div/input</option><option>css=#reg-name</option></datalist></td><td>joão soares</td></tr>
<tr><td>type</td><td>id=reg-email<datalist><option>id=reg-email</option><option>xpath=//input[@id='reg-email']</option><option>xpath=//div[@id='form-register']/div[2]/input</option><option>xpath=//div[3]/div[2]/input</option><option>css=#reg-email</option></datalist></td><td>joao@gmail.com</td></tr>
<tr><td>type</td><td>id=reg-pass<datalist><option>id=reg-pass</option><option>xpath=//input[@id='reg-pass']</option><option>xpath=//div[@id='form-register']/div[3]/input</option><option>xpath=//div[3]/input</option><option>css=#reg-pass</option></datalist></td><td>joaosoares</td></tr>
<tr><td>click</td><td>xpath=//input[@value='Ovo']<datalist><option>xpath=//input[@value='Ovo']</option><option>xpath=//div[@id='form-register']/div[4]/div/label[4]/input</option><option>xpath=//label[4]/input</option></datalist></td><td></td></tr>
<tr><td>click</td><td>id=btn-register<datalist><option>id=btn-register</option><option>xpath=//button[@id='btn-register']</option><option>xpath=//div[@id='form-register']/button</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Ovo'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Frutos Secos'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Já tens conta? Iniciar Sessão'])[1]/preceding::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Conta Existente'])[1]/preceding::button[1]</option><option>xpath=//*/text()[normalize-space(.)='Criar Conta']/parent::*</option><option>xpath=//div[3]/button</option><option>css=#btn-register</option></datalist></td><td></td></tr>
</tbody></table>
